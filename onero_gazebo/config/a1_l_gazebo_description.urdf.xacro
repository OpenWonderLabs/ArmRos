<?xml version="1.0" encoding="utf-8"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="a1_l_gazebo">

    <!-- ========== 机械臂模型定义（来自a1_l.urdf.xacro） ========== -->

    <!-- 导入a1_l的URDF模型（xacro版本，包含ros2_control配置） -->
    <xacro:include filename="$(find onero_description)/urdf/A1/a1_l.urdf.xacro" />

    <!-- ========== Gazebo属性设置 ========== -->

    <gazebo reference="base_link">
        <self_collide>false</self_collide>
        <gravity>false</gravity>
    </gazebo>

    <gazebo reference="Link1">
        <material>Gazebo/White</material>
        <self_collide>false</self_collide>
        <gravity>false</gravity>
    </gazebo>

    <gazebo reference="Link2">
        <material>Gazebo/White</material>
        <self_collide>false</self_collide>
        <gravity>false</gravity>
    </gazebo>

    <gazebo reference="Link3">
        <material>Gazebo/White</material>
        <self_collide>false</self_collide>
        <gravity>false</gravity>
    </gazebo>

    <gazebo reference="Link4">
        <material>Gazebo/White</material>
        <self_collide>false</self_collide>
        <gravity>false</gravity>
    </gazebo>

    <gazebo reference="Link5">
        <material>Gazebo/White</material>
        <self_collide>false</self_collide>
        <gravity>false</gravity>
    </gazebo>

    <gazebo reference="Link6">
        <material>Gazebo/White</material>
        <self_collide>false</self_collide>
        <gravity>false</gravity>
    </gazebo>

    <gazebo reference="Link7">
        <material>Gazebo/White</material>
        <self_collide>false</self_collide>
        <gravity>false</gravity>
    </gazebo>

    <gazebo>
        <self_collide>true</self_collide>
    </gazebo>

    <!-- ros2_control配置已移至a1_l.urdf.xacro中 -->

</robot>
