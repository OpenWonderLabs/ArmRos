<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>onero_bringup</name>
  <version>0.0.0</version>
  <description>Top-level launch package for Onero bringup</description>
  <maintainer email="support@switch-bot.com">OneRobotics</maintainer>
  <license>MIT</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <exec_depend>onero_description</exec_depend>
  <exec_depend>onero_driver</exec_depend>
  <exec_depend>onero_control</exec_depend>
  <exec_depend>moveit_config</exec_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
