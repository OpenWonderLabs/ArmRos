<?xml version="1.0" encoding="utf-8"?>
<!-- X1-R机械臂URDF模型 -->
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="x1_r_urdf">

  <!-- 网格文件路径前缀 (可被外部覆盖，默认使用package://) -->
  <xacro:arg name="mesh_prefix" default="package://woan_description" />
  <xacro:property name="mesh_prefix_value" value="$(arg mesh_prefix)" />

  <!-- 材料定义 -->
  <material name="silver">
    <color rgba="0.752941176470588 0.752941176470588 0.752941176470588 1"/>
  </material>
  
  <material name="light_blue">
    <color rgba="0.898039215686275 0.917647058823529 0.929411764705882 1"/>
  </material>

  <!-- 虚拟根link (KDL兼容性) - 仅在非Gazebo环境中使用，Gazebo环境由gazebo_description提供 -->
  <!-- <link name="world"/> -->
  
  <!-- 基座连杆 -->
  <link name="base_link-r">
    <inertial>
      <origin xyz="0.000159939440822284 -6.20605455741537E-07 0.0304553601466284" rpy="0 0 0" />
      <mass value="0.472235089167281" />
      <inertia ixx="0.000272166948190831" ixy="-4.20107335007513E-08" ixz="-2.63102389036083E-06" 
               iyy="0.000257572811141141" iyz="2.99310496958811E-07" izz="0.000367714560088986" />
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <mesh filename="${mesh_prefix_value}/meshes/v3.2/base_link-r.STL" />
      </geometry>
      <material name="silver"/>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <mesh filename="${mesh_prefix_value}/meshes/v3.2/base_link-r.STL" />
      </geometry>
    </collision>
  </link>

  <!-- 虚拟根关节 - 仅在非Gazebo环境中使用，Gazebo环境由gazebo_description提供 -->
  <!-- <joint name="world_to_base" type="fixed">
    <parent link="world"/>
    <child link="base_link-r"/>
    <origin xyz="0 0 0" rpy="0 0 0"/>
  </joint> -->

  <!-- 连杆1 -->
  <link name="Link1-r">
    <inertial>
      <origin xyz="-0.00885278318247 -0.000280590563195875 0.0670633884885824" rpy="0 0 0" />
      <mass value="0.397204280978561" />
      <inertia ixx="0.000370077014764152" ixy="-1.06759278545413E-06" ixz="4.91266150882398E-05" 
               iyy="0.000386592571747438" iyz="2.22018592880807E-09" izz="0.000177520078050015" />
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <mesh filename="${mesh_prefix_value}/meshes/v3.2/Link1-r.STL" />
      </geometry>
      <material name="silver"/>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <mesh filename="${mesh_prefix_value}/meshes/v3.2/Link1-r.STL" />
      </geometry>
    </collision>
  </link>

  <!-- 关节1 -->
  <joint name="joint1-x1_r" type="revolute">
    <parent link="base_link-r"/>
    <child link="Link1-r"/>
    <origin xyz="0 0 0.0585" rpy="0 0 0"/>
    <axis xyz="0 0 1"/>
    <limit lower="-1.05" upper="3.14" effort="0" velocity="0"/>
  </joint>

  <!-- 连杆2 -->
  <link name="Link2-r">
    <inertial>
      <origin xyz="0.000280590563195875 0.00885278318247 0.0670633884885824" rpy="0 0 0" />
      <mass value="0.397204280978561" />
      <inertia ixx="0.000370077014764152" ixy="-1.06759278545413E-06" ixz="4.91266150882398E-05" 
               iyy="0.000386592571747438" iyz="2.22018592880807E-09" izz="0.000177520078050015" />
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <mesh filename="${mesh_prefix_value}/meshes/v3.2/Link2-r.STL" />
      </geometry>
      <material name="silver"/>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <mesh filename="${mesh_prefix_value}/meshes/v3.2/Link2-r.STL" />
      </geometry>
    </collision>
  </link>

  <!-- 关节2 -->
  <joint name="joint2-x1_r" type="revolute">
    <parent link="Link1-r"/>
    <child link="Link2-r"/>
    <origin xyz="0.0279999999999086 0 0.0994500000000517" rpy="0 1.5707963267949 0"/>
    <axis xyz="0 0 1"/>
    <limit lower="-3.58" upper="0.44" effort="0" velocity="0"/>
  </joint>

  <!-- 连杆3 -->
  <link name="Link3-r">
    <inertial>
      <origin xyz="0.000280590563195875 0.00885278318247 0.0670633884885824" rpy="0 0 0" />
      <mass value="0.397204280978561" />
      <inertia ixx="0.000370077014764152" ixy="-1.06759278545413E-06" ixz="4.91266150882398E-05" 
               iyy="0.000386592571747438" iyz="2.22018592880807E-09" izz="0.000177520078050015" />
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <mesh filename="${mesh_prefix_value}/meshes/v3.2/Link3-r.STL" />
      </geometry>
      <material name="silver"/>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <mesh filename="${mesh_prefix_value}/meshes/v3.2/Link3-r.STL" />
      </geometry>
    </collision>
  </link>

  <!-- 关节3 -->
  <joint name="joint3-x1_r" type="revolute">
    <parent link="Link2-r"/>
    <child link="Link3-r"/>
    <origin xyz="0 -0.111249999999909 -0.0280000000000575" rpy="1.57079632679488 0 0"/>
    <axis xyz="0 0 1"/>
    <limit lower="-2.76" upper="2.76" effort="0" velocity="0"/>
  </joint>

  <!-- 连杆4 -->
  <link name="Link4-r">
    <inertial>
      <origin xyz="0.000280590563195875 0.00885278318247 0.0670633884885824" rpy="0 0 0" />
      <mass value="0.397204280978561" />
      <inertia ixx="0.000370077014764152" ixy="-1.06759278545413E-06" ixz="4.91266150882398E-05" 
               iyy="0.000386592571747438" iyz="2.22018592880807E-09" izz="0.000177520078050015" />
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <mesh filename="${mesh_prefix_value}/meshes/v3.2/Link4-r.STL" />
      </geometry>
      <material name="silver"/>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <mesh filename="${mesh_prefix_value}/meshes/v3.2/Link4-r.STL" />
      </geometry>
    </collision>
  </link>

  <!-- 关节4 -->
  <joint name="joint4-x1_r" type="revolute">
    <parent link="Link3-r"/>
    <child link="Link4-r"/>
    <origin xyz="-0.0279000000000598 0 0.12224999999998" rpy="1.57079632679438 0 1.57079632679462"/>
    <axis xyz="0 0 1"/>
    <limit lower="-1.95" upper="1.95" effort="0" velocity="0"/>
  </joint>

  <!-- 连杆5 -->
  <link name="Link5-r">
    <inertial>
      <origin xyz="0.000280590563195875 0.00885278318247 0.0670633884885824" rpy="0 0 0" />
      <mass value="0.397204280978561" />
      <inertia ixx="0.000370077014764152" ixy="-1.06759278545413E-06" ixz="4.91266150882398E-05" 
               iyy="0.000386592571747438" iyz="2.22018592880807E-09" izz="0.000177520078050015" />
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <mesh filename="${mesh_prefix_value}/meshes/v3.2/Link5-r.STL" />
      </geometry>
      <material name="silver"/>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <mesh filename="${mesh_prefix_value}/meshes/v3.2/Link5-r.STL" />
      </geometry>
    </collision>
  </link>

  <!-- 关节5 -->
  <joint name="joint5-x1_r" type="revolute">
    <parent link="Link4-r"/>
    <child link="Link5-r"/>
    <origin xyz="0.00016162 0.101 0.028241" rpy="-1.5708 0 0"/>
    <axis xyz="0 0 1"/>
    <limit lower="-2.33" upper="2.33" effort="0" velocity="0"/>
  </joint>

  <!-- 连杆6 -->
  <link name="Link6-r">
    <inertial>
      <origin xyz="0.000280590563195875 0.00885278318247 0.0670633884885824" rpy="0 0 0" />
      <mass value="0.397204280978561" />
      <inertia ixx="0.000370077014764152" ixy="-1.06759278545413E-06" ixz="4.91266150882398E-05" 
               iyy="0.000386592571747438" iyz="2.22018592880807E-09" izz="0.000177520078050015" />
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <mesh filename="${mesh_prefix_value}/meshes/v3.2/Link6-r.STL" />
      </geometry>
      <material name="silver"/>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <mesh filename="${mesh_prefix_value}/meshes/v3.2/Link6-r.STL" />
      </geometry>
    </collision>
  </link>

  <!-- 关节6 -->
  <joint name="joint6-x1_r" type="revolute">
    <parent link="Link5-r"/>
    <child link="Link6-r"/>
    <origin xyz="-0.00016162 -0.023409 0.12" rpy="1.5708 0 0"/>
    <axis xyz="0 0 -1"/>
    <limit lower="-1.74" upper="1.74" effort="0" velocity="0"/>
  </joint>

  <!-- 连杆7 -->
  <link name="Link7-r">
    <inertial>
      <origin xyz="0.000280590563195875 0.00885278318247 0.0670633884885824" rpy="0 0 0" />
      <mass value="0.397204280978561" />
      <inertia ixx="0.000370077014764152" ixy="-1.06759278545413E-06" ixz="4.91266150882398E-05" 
               iyy="0.000386592571747438" iyz="2.22018592880807E-09" izz="0.000177520078050015" />
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <mesh filename="${mesh_prefix_value}/meshes/v3.2/Link7-r.STL" />
      </geometry>
      <material name="silver"/>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <mesh filename="${mesh_prefix_value}/meshes/v3.2/Link7-r.STL" />
      </geometry>
    </collision>
  </link>

  <!-- 关节7 -->
  <joint name="joint7-x1_r" type="revolute">
    <parent link="Link6-r"/>
    <child link="Link7-r"/>
    <origin xyz="0 0.112 -0.02825" rpy="1.5708 0 -3.1416"/>
    <axis xyz="0 0 1"/>
    <limit lower="-3.14" upper="3.14" effort="0" velocity="0"/>
  </joint>

  <!-- ros2_control配置 - 7自由度关节 -->
  <ros2_control name="GazeboSystem" type="system">
    <hardware>
      <plugin>gazebo_ros2_control/GazeboSystem</plugin>
    </hardware>
    
    <!-- 7自由度关节配置 -->
    <joint name="joint1-x1_r">
      <command_interface name="position"/>
      <state_interface name="position">
        <param name="initial_value">0</param>
      </state_interface>
      <state_interface name="velocity"/>
    </joint>
    <joint name="joint2-x1_r">
      <command_interface name="position"/>
      <state_interface name="position">
        <param name="initial_value">0</param>
      </state_interface>
      <state_interface name="velocity"/>
    </joint>
    <joint name="joint3-x1_r">
      <command_interface name="position"/>
      <state_interface name="position">
        <param name="initial_value">0</param>
      </state_interface>
      <state_interface name="velocity"/>
    </joint>
    <joint name="joint4-x1_r">
      <command_interface name="position"/>
      <state_interface name="position">
        <param name="initial_value">0</param>
      </state_interface>
      <state_interface name="velocity"/>
    </joint>
    <joint name="joint5-x1_r">
      <command_interface name="position"/>
      <state_interface name="position">
        <param name="initial_value">0</param>
      </state_interface>
      <state_interface name="velocity"/>
    </joint>
    <joint name="joint6-x1_r">
      <command_interface name="position"/>
      <state_interface name="position">
        <param name="initial_value">0</param>
      </state_interface>
      <state_interface name="velocity"/>
    </joint>
    <joint name="joint7-x1_r">
      <command_interface name="position"/>
      <state_interface name="position">
        <param name="initial_value">0</param>
      </state_interface>
      <state_interface name="velocity"/>
    </joint>
  </ros2_control>

  <!-- Gazebo插件配置 -->
  <gazebo>
    <plugin filename="libgazebo_ros2_control.so" name="gazebo_ros2_control">
      <parameters>$(find x1_r_config)/config/ros2_controllers.yaml</parameters>
      <robot_param>robot_description</robot_param>
      <robot_param_node>robot_state_publisher</robot_param_node>
    </plugin>
  </gazebo>

</robot>
