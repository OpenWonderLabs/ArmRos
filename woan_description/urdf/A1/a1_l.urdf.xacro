<?xml version="1.0" encoding="utf-8"?>
<!-- A1-L机械臂URDF模型 -->
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="a1_l_urdf">

  <!-- 网格文件路径前缀 (可被外部覆盖，默认使用package://) -->
  <xacro:arg name="mesh_prefix" default="package://woan_description" />
  <xacro:property name="mesh_prefix_value" value="$(arg mesh_prefix)" />

  <!-- 材料定义 -->
  <material name="silver">
    <color rgba="0.752941176470588 0.752941176470588 0.752941176470588 1"/>
  </material>
  
  <material name="light_blue">
    <color rgba="0.898039215686275 0.917647058823529 0.929411764705882 1"/>
  </material>

  <!-- 基座连杆 -->
  <link name="base_link">
<inertial>
      <origin
        xyz="2.12826196715557E-05 -5.52026218782097E-05 0.0171427754448579"
        rpy="0 0 0" />
      <mass
        value="0.401650168942009" />
      <inertia
        ixx="0.000237179758518644"
        ixy="1.22424408206913E-07"
        ixz="1.57836402935181E-07"
        iyy="0.000248236117612461"
        iyz="7.93541349379853E-07"
        izz="0.000305122605170233" />
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <mesh filename="${mesh_prefix_value}/meshes/A1/A1_l/base_link.STL" />
      </geometry>
      <material name="silver"/>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <mesh filename="${mesh_prefix_value}/meshes/A1/A1_l/base_link.STL" />
      </geometry>
    </collision>
  </link>

  <!-- 连杆1 -->
  <link name="Link1">
    <inertial>
      <origin
        xyz="-0.000104793909039569 0.000878025489583305 0.0937688680157419"
        rpy="0 0 0" />
      <mass
        value="0.438675872181416" />
      <inertia
        ixx="0.00060517294321352"
        ixy="3.1414337686272E-07"
        ixz="9.46425739217291E-07"
        iyy="0.000501491467720591"
        iyz="-3.30016145254686E-05"
        izz="0.00025580993277449" />
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <mesh filename="${mesh_prefix_value}/meshes/A1/A1_l/Link1.STL" />
      </geometry>
      <material name="light_blue"/>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <mesh filename="${mesh_prefix_value}/meshes/A1/A1_l/Link1.STL" />
      </geometry>
    </collision>
  </link>

  <!-- 关节1 -->
  <joint name="joint1-a1_l" type="revolute">
    <origin xyz="0 0 0.0125" rpy="0 0 0" />
    <parent link="base_link" />
    <child link="Link1" />
    <axis xyz="0 0 1" />
    <limit
      lower="-3.14"
      upper="1.04"
      effort="0"
      velocity="0" />
  </joint>

  <!-- 连杆2 -->
  <link name="Link2">
    <inertial>
      <origin
        xyz="4.66303482215547E-05 -0.0610765811025605 0.00481122218899704"
        rpy="0 0 0" />
      <mass
        value="0.387770755219132" />
      <inertia
        ixx="0.000597204372907025"
        ixy="8.36763420077846E-07"
        ixz="-2.69873967501812E-08"
        iyy="0.000348292487571024"
        iyz="-2.93717934653094E-05"
        izz="0.000403661570691348" />
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <mesh filename="${mesh_prefix_value}/meshes/A1/A1_l/Link2.STL" />
      </geometry>
      <material name="light_blue"/>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <mesh filename="${mesh_prefix_value}/meshes/A1/A1_l/Link2.STL" />
      </geometry>
    </collision>
  </link>

  <!-- 关节2 -->
  <joint name="joint2-a1_l" type="revolute">
    <origin
      xyz="0 0 0.12745"
      rpy="1.5708 -1.5708 0" />
    <parent link="Link1" />
    <child link="Link2" />
    <axis
      xyz="0 0 1" />
    <limit
      lower="-0.26"
      upper="3.14"
      effort="0"
      velocity="0" />
  </joint>

  <!-- 连杆3 -->
  <link name="Link3">
    <inertial>
      <origin
        xyz="1.43987309591522E-05 0.00178404133280441 0.109669668659996"
        rpy="0 0 0" />
      <mass
        value="0.407125793506889" />
      <inertia
        ixx="0.000446520666780017"
        ixy="-8.24275545731468E-09"
        ixz="1.61110520939152E-07"
        iyy="0.000343044757246363"
        iyz="-1.30123176926368E-05"
        izz="0.000286204871222088" />
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <mesh filename="${mesh_prefix_value}/meshes/A1/A1_l/Link3.STL" />
      </geometry>
      <material name="light_blue"/>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <mesh filename="${mesh_prefix_value}/meshes/A1/A1_l/Link3.STL" />
      </geometry>
    </collision>
  </link>

  <!-- 关节3 -->
  <joint name="joint3-a1_l" type="revolute">
    <origin
      xyz="0 -0.09325 -0.0001"
      rpy="1.5708 -1.5708 0" />
    <parent link="Link2" />
    <child link="Link3" />
    <axis xyz="0 0 1" />
    <limit
      lower="-2.758"
      upper="2.758"
      effort="0"
      velocity="0" />
  </joint>

  <!-- 连杆4 -->
  <link name="Link4">
    <inertial>
      <origin
        xyz="-9.99808131922311E-07 0.0625047132640995 0.00555704355349793"
        rpy="0 0 0" />
      <mass
        value="0.252142897202372" />
      <inertia
        ixx="0.000178779070280237"
        ixy="-6.97346977234495E-09"
        ixz="-7.78451594087313E-10"
        iyy="0.000146134678616042"
        iyz="3.30147349592292E-05"
        izz="0.000165597697680657" />
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <mesh filename="${mesh_prefix_value}/meshes/A1/A1_l/Link4.STL" />
      </geometry>
      <material name="light_blue"/>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <mesh filename="${mesh_prefix_value}/meshes/A1/A1_l/Link4.STL" />
      </geometry>
    </collision>
  </link>

  <!-- 关节4 -->
  <joint name="joint4-a1_l" type="revolute">
    <origin
      xyz="0 -0.000999999996676215 0.140249999995695"
      rpy="1.57079632678358 0 6.73358220455809E-05" />
    <parent link="Link3" />
    <child link="Link4" />
    <axis
      xyz="0 0 1" />
    <limit
      lower="-1.92"
      upper="1.92"
      effort="0"
      velocity="0" />
  </joint>

  <!-- 连杆5 -->
  <link name="Link5">
    <inertial>
      <origin
        xyz="2.1819607269304E-06 0.000940045309240356 0.0983077176130554"
        rpy="0 0 0" />
      <mass
        value="0.333953527048094" />
      <inertia
        ixx="0.000324219442352689"
        ixy="-1.17918294445498E-09"
        ixz="-7.21118252231978E-08"
        iyy="0.000299078218859742"
        iyz="5.7924183985276E-06"
        izz="0.000161241194938864" />
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <mesh filename="${mesh_prefix_value}/meshes/A1/A1_l/Link5.STL" />
      </geometry>
      <material name="light_blue"/>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <mesh filename="${mesh_prefix_value}/meshes/A1/A1_l/Link5.STL" />
      </geometry>
    </collision>
  </link>

  <!-- 关节5 -->
  <joint name="joint5-a1_l" type="revolute">
    <origin
      xyz="0 0.08800000000195 -0.00100000000141642"
      rpy="-1.57079632679444 0 0" />
    <parent link="Link4" />
    <child link="Link5" />
    <axis
      xyz="0 0 1" />
    <limit
      lower="-2.758"
      upper="2.758"
      effort="0"
      velocity="0" />
  </joint>

  <!-- 连杆6 -->
  <link name="Link6">
    <inertial>
      <origin
        xyz="-1.41083567195476E-05 -0.0616500007920044 0.00592126579182656"
        rpy="0 0 0" />
      <mass
        value="0.289938784061927" />
      <inertia
        ixx="0.000346578289881221"
        ixy="-3.69413578027761E-07"
        ixz="1.71707534440891E-07"
        iyy="0.000183154957217547"
        iyz="-3.25615026642568E-05"
        izz="0.000268358636952706" />
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <mesh filename="${mesh_prefix_value}/meshes/A1/A1_l/Link6.STL" />
      </geometry>
      <material
        name="">
        <color
          rgba="1 1 1 1" />
      </material>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <mesh filename="${mesh_prefix_value}/meshes/A1/A1_l/Link6.STL" />
      </geometry>
    </collision>
  </link>

  <!-- 关节6 -->
  <joint name="joint6-a1_l" type="revolute">
    <origin
      xyz="0 0.0005 0.133"
      rpy="-1.5708 0 0" />
    <parent link="Link5" />
    <child link="Link6" />
    <axis
      xyz="0 0 1" />
    <limit
      lower="-1.57"
      upper="1.57"
      effort="0"
      velocity="0" />
  </joint>

  <!-- 连杆7 -->
  <link name="Link7">
    <inertial>
      <origin
        xyz="-1.47613369245068E-07 -0.00220208936053254 0.00293052049190767"
        rpy="0 0 0" />
      <mass
        value="0.017750642712371" />
      <inertia
        ixx="2.81905932676299E-06"
        ixy="-6.21960184961116E-11"
        ixz="1.30043055619343E-13"
        iyy="1.89453432604882E-06"
        iyz="2.22904228240977E-09"
        izz="4.60994189557911E-06" />
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <mesh filename="${mesh_prefix_value}/meshes/A1/A1_l/Link7.STL" />
      </geometry>
      <material name="light_blue"/>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <mesh filename="${mesh_prefix_value}/meshes/A1/A1_l/Link7.STL" />
      </geometry>
    </collision>
  </link>

  <!-- 关节7 -->
  <joint name="joint7-a1_l" type="revolute">
    <origin
      xyz="0 -0.112 0.00025"
      rpy="1.5708 0 0" />
    <parent link="Link6" />
    <child link="Link7" />
    <axis xyz="0 0 1" />
    <limit
      lower="-2.758"
      upper="2.758"
      effort="0"
      velocity="0" />
  </joint>

  <!-- ros2_control配置 - 7自由度关节 -->
  <ros2_control name="GazeboSystem" type="system">
    <hardware>
      <plugin>gazebo_ros2_control/GazeboSystem</plugin>
    </hardware>
    
    <!-- 7自由度关节配置 -->
    <joint name="joint1-a1_l">
      <command_interface name="position"/>
      <state_interface name="position">
        <param name="initial_value">0</param>
      </state_interface>
      <state_interface name="velocity"/>
    </joint>
    <joint name="joint2-a1_l">
      <command_interface name="position"/>
      <state_interface name="position">
        <param name="initial_value">0</param>
      </state_interface>
      <state_interface name="velocity"/>
    </joint>
    <joint name="joint3-a1_l">
      <command_interface name="position"/>
      <state_interface name="position">
        <param name="initial_value">0</param>
      </state_interface>
      <state_interface name="velocity"/>
    </joint>
    <joint name="joint4-a1_l">
      <command_interface name="position"/>
      <state_interface name="position">
        <param name="initial_value">0</param>
      </state_interface>
      <state_interface name="velocity"/>
    </joint>
    <joint name="joint5-a1_l">
      <command_interface name="position"/>
      <state_interface name="position">
        <param name="initial_value">0</param>
      </state_interface>
      <state_interface name="velocity"/>
    </joint>
    <joint name="joint6-a1_l">
      <command_interface name="position"/>
      <state_interface name="position">
        <param name="initial_value">0</param>
      </state_interface>
      <state_interface name="velocity"/>
    </joint>
    <joint name="joint7-a1_l">
      <command_interface name="position"/>
      <state_interface name="position">
        <param name="initial_value">0</param>
      </state_interface>
      <state_interface name="velocity"/>
    </joint>
  </ros2_control>

  <!-- Gazebo插件配置 -->
  <gazebo>
    <plugin filename="libgazebo_ros2_control.so" name="gazebo_ros2_control">
      <parameters>$(find a1_l_config)/config/ros2_controllers.yaml</parameters>
      <robot_param>robot_description</robot_param>
      <robot_param_node>robot_state_publisher</robot_param_node>
    </plugin>
  </gazebo>

</robot>
